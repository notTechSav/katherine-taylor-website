# Custom domain (katherinetaylorescort.com) applies zone Browser Cache TTL
# (~4h) on static assets. Keep the About mobile photo revalidate-friendly so
# replacements are not stuck on phones after a same-URL update.
/about-slide-mobile.webp
  Cache-Control: public, max-age=0, must-revalidate

# Icon files must revalidate immediately. Zone Browser Cache TTL would
# otherwise keep a leftover template mark (Cartier wordmark / Builder "B")
# on phones for hours after a same-URL replace.
/favicon.svg
  Cache-Control: public, max-age=0, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=0, must-revalidate

# Low-risk headers not already supplied by the Cloudflare zone.
# Live apex already sends X-Content-Type-Options, X-Frame-Options, and
# Referrer-Policy. HSTS is deferred until www HTTPS is healthy.
/*
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
